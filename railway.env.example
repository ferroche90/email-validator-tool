# Railway Environment Configuration
# Copy this file to .env.railway and update the values for your Railway deployment

# Environment
ENVIRONMENT=prod
DEBUG=false

# Database (Railway will provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# SMTP settings
SMTP_TIMEOUT=10
SMTP_PORT=25
MAX_CONCURRENT_CONNECTIONS=10
PER_DOMAIN_DELAY_SECONDS=1.0

# DNS Cache settings
ENABLE_DNS_CACHE=true
DNS_CACHE_TTL_SECONDS=3600
CATCH_ALL_CACHE_TTL_SECONDS=3600

# Validation settings
ENABLE_SMTP=false
ENABLE_CATCH_ALL=false

# Metrics
METRICS_ALLOWLIST=127.0.0.1,::1
ENABLE_METRICS=true

# Frontend API URL (Railway will provide this)
# VITE_API_URL=https://your-app-name.railway.app 