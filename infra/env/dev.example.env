# Development Environment Configuration
# Copy this file to .env.dev for local development

# Environment
ENVIRONMENT=dev
DEBUG=true

# JWT Configuration
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Keys for JWT token generation
API_KEY_USER=user_api_key_here
API_KEY_ADMIN=admin_api_key_here

# Database
DATABASE_URL=sqlite:///app.db

# Logging
LOG_LEVEL=DEBUG

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# DNS Cache
ENABLE_DNS_CACHE=True
DNS_CACHE_TTL_SECONDS=3600

# SMTP Configuration
SMTP_TIMEOUT=10
SMTP_PORT=25
MAX_CONCURRENT_CONNECTIONS=10
PER_DOMAIN_DELAY_SECONDS=1.0

# Validation Options
ENABLE_CATCH_ALL=False
ENABLE_SMTP=False

# General parameters
CSV_INPUT_PATH=emails.csv
CSV_OUTPUT_PATH=results.csv 