# Development Environment Configuration
# Copy this file to .env.dev for local development

# Environment
ENVIRONMENT=dev
DEBUG=true

# API Configuration
API_TOKEN=dev_token_here
ADMIN_TOKEN=dev_admin_token_here

# Database
DATABASE_URL=sqlite:///app.db

# Logging
LOG_LEVEL=DEBUG

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# DNS Cache
ENABLE_DNS_CACHE=True
DNS_CACHE_TTL_SECONDS=3600

# SMTP Configuration
SMTP_TIMEOUT=10
SMTP_PORT=25
MAX_CONCURRENT_CONNECTIONS=10
PER_DOMAIN_DELAY_SECONDS=1.0

# Validation Options
ENABLE_CATCH_ALL=False
ENABLE_SMTP=False

# General parameters
CSV_INPUT_PATH=emails.csv
CSV_OUTPUT_PATH=results.csv 