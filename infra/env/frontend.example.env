# Frontend Environment Configuration
# Copy this file to frontend/.env for local development

# API Configuration
VITE_API_URL=http://localhost:8000

# JWT Authentication (Recommended)
# Use an API key to get JWT tokens automatically
VITE_API_KEY=test_admin_api_key

# Note: Only variables prefixed with VITE_ are available to the frontend
# Make sure VITE_API_KEY matches a valid API key in your key manager 