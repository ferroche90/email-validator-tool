# Production Environment Configuration
# Copy this file to .env.prod for production deployment
# IMPORTANT: Replace all placeholder values with secure production values

# Environment
ENVIRONMENT=prod
DEBUG=false

# JWT Configuration
JWT_SECRET_KEY=your-production-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Keys for JWT token generation
API_KEY_USER=your_production_user_api_key_here
API_KEY_ADMIN=your_production_admin_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost/email_validator

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# DNS Cache
ENABLE_DNS_CACHE=True
DNS_CACHE_TTL_SECONDS=3600

# SMTP Configuration
SMTP_TIMEOUT=10
SMTP_PORT=25
MAX_CONCURRENT_CONNECTIONS=10
PER_DOMAIN_DELAY_SECONDS=5.0

# Validation Options
ENABLE_CATCH_ALL=False
ENABLE_SMTP=False

# General parameters
CSV_INPUT_PATH=emails.csv
CSV_OUTPUT_PATH=results.csv 