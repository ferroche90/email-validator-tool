# Production Environment Configuration
# Copy this file to .env for production deployment
# Suitable for Railway, Render, or any production environment

# Environment
ENVIRONMENT=prod
DEBUG=false

# JWT Configuration
JWT_SECRET_KEY=your-production-secret-key-here-must-be-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Railway/Render will provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Logging
LOG_LEVEL=INFO

# CORS (set to your actual frontend domain in production)
# Example: https://your-frontend-domain.com,https://www.your-frontend-domain.com
# For Railway/Render, use the deployed frontend URL
CORS_ORIGINS=https://your-app-name.railway.app

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# DNS Cache
ENABLE_DNS_CACHE=true
DNS_CACHE_TTL_SECONDS=3600
CATCH_ALL_CACHE_TTL_SECONDS=3600

# SMTP Configuration
SMTP_TIMEOUT=10
SMTP_PORT=25
MAX_CONCURRENT_CONNECTIONS=10
PER_DOMAIN_DELAY_SECONDS=1.0

# Validation Options
ENABLE_CATCH_ALL=false
ENABLE_SMTP=false

# General parameters
CSV_INPUT_PATH=emails.csv
CSV_OUTPUT_PATH=results.csv

# Observability
METRICS_ALLOWLIST=127.0.0.1,::1
ENABLE_METRICS=true

# Frontend API URL (set after deployment)
# VITE_API_URL=https://your-app-name.railway.app 