# Frontend Production Environment Configuration
# Copy this file to frontend/.env for production deployment
# IMPORTANT: Replace all placeholder values with secure production values

# API Configuration
VITE_API_URL=https://your-api-domain.com

# JWT Authentication
# Use an API key to get JWT tokens automatically
VITE_API_KEY=your-production-api-key-here

# Note: Only variables prefixed with VITE_ are available to the frontend
# Make sure VITE_API_KEY matches a valid API key in your key manager 